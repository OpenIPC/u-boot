				flash0_flvdd_vol;
				device_id = <0x00>;
				status = "disabled";
				phandle = <0x90>;
			};

			sensor@0 {
				device_type = "sensor0";
				compatible = "allwinner,sunxi-sensor";
				clocks = <0x87 0x08 0x03>;
				pinctrl-names = "mclk0-default", "mclk0-sleep";
				pinctrl-0 = <0x8a>;
				pinctrl-1 = <0x8b>;
				sensor0_mname = "sc2232_mipi";
				sensor0_twi_cci_id = <0x01>;
				sensor0_twi_addr = <0x60>;
				sensor0_mclk_id = <0x00>;
				sensor0_pos = "rear";
				sensor0_isp_used = <0x01>;
				sensor0_fmt = <0x01>;
				sensor0_stby_mode = <0x00>;
				sensor0_vflip = <0x00>;
				sensor0_hflip = <0x00>;
				sensor0_iovdd-supply;
				sensor0_iovdd_vol = <0x1b7740>;
				sensor0_avdd-supply;
				sensor0_avdd_vol = <0x2ab980>;
				sensor0_dvdd-supply;
				sensor0_dvdd_vol = <0x124f80>;
				sensor0_power_en;
				sensor0_reset = <0x41 0x08 0x03 0x01 0x00 0x01 0x00>;
				sensor0_pwdn = <0x41 0x08 0x04 0x01 0x00 0x01 0x00>;
				flash_handle = <0x90>;
				act_handle = <0x91>;
				device_id = <0x00>;
				status = "okay";
			};

			sensor@1 {
				device_type = "sensor1";
				compatible = "allwinner,sunxi-sensor";
				clocks = <0x88 0x08 0x03>;
				pinctrl-names = "mclk1-default", "mclk1-sleep";
				pinctrl-0 = <0x8c>;
				pinctrl-1 = <0x8d>;
