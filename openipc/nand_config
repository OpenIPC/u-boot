# SPI NAND images: appended after openipc/<soc>_config. OpenIPC's NAND
# layout, 768k(boot),256k(env),-(ubi), with the kernel inside the UBIFS
# rootfs (/boot/fitImage, or /boot/uImage).
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
# CONFIG_SPL_SPI_LOAD is not set
# CONFIG_SPL_SPI_FLASH_SUPPORT is not set
# CONFIG_SPL_DM_SPI_FLASH is not set
CONFIG_MTD=y
CONFIG_DM_MTD=y
CONFIG_MTD_RAW_NAND=y
CONFIG_SYS_NAND_SELF_INIT=y
CONFIG_MTD_SPI_NAND=y
CONFIG_MTD_PARTITIONS=y
CONFIG_ENV_IS_IN_NAND=y
CONFIG_ENV_OFFSET=0xc0000
CONFIG_ENV_SIZE=0x40000
CONFIG_ENV_RANGE=0x40000
CONFIG_MTD_UBI=y
CONFIG_CMD_UBI=y
CONFIG_CMD_UBIFS=y
CONFIG_CMD_NAND=y
CONFIG_CMD_MTD=y
CONFIG_CMD_MTDPARTS=y
CONFIG_SHA1=y
