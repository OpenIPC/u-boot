# AK3918EV200 boot ROM register script (header +0x2c), as on the
# V380E2 camera's flash and in the EV200 U-Boot port's
# ddr-script-ak3918ev200.txt: ASIC PLL, then the DDR2 controller.
# "addr = value" writes, "delay n" waits, "end" closes the table.

0x08000004 = 0x011253c8
delay 0x000000c8
0x21000078 = 0x00009041
0x21000004 = 0x0d493315
0x21000008 = 0x00145133
0x21000000 = 0x00104c90
0x21000010 = 0x02000000
0x21000010 = 0x02f00000
0x21000010 = 0x02a00400
0x21000010 = 0x02820000
0x21000010 = 0x02830000
0x21000010 = 0x02810402
0x21000010 = 0x02800532
0x21000010 = 0x02a00400
0x21000010 = 0x02c00000
0x21000010 = 0x02c00000
0x21000010 = 0x02800432
delay 0x000000c8
0x21000010 = 0x02810782
0x21000010 = 0x02810402
0x21000010 = 0x02f00000
0x2100000c = 0x00000a8b
0x21000020 = 0x00000003
delay 0x000000c8
0x21000024 = 0x00000001
delay 0x0007a120
end
