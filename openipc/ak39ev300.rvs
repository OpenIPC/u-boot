# AK391xEV300 boot ROM register script (header +0x2c): the SDK's
# AKinit.S (CPU PLL, then the DDR2 controller), the same on every EV300
# and AK3916EV301 camera flash seen. "addr = value" writes, "delay n"
# waits, "end" closes the table.

0x08000004 = 0x410053c8
delay 0x000000c8
0x21000078 = 0x0001b2cb
0x21000004 = 0x1db57833
0x21000008 = 0x00405557
0x21000000 = 0x00134d68
0x21000010 = 0x02000000
0x21000010 = 0x02f00000
0x21000010 = 0x02a00400
0x21000010 = 0x02820000
0x21000010 = 0x02830000
0x21000010 = 0x02810042
0x21000010 = 0x02800f62
0x21000010 = 0x02a00400
0x21000010 = 0x02c00000
0x21000010 = 0x02c00000
0x21000010 = 0x02800e62
delay 0x000000c8
0x21000010 = 0x028103c2
0x21000010 = 0x02810042
0x21000010 = 0x02f00000
0x2100000c = 0x00001801
0x21000020 = 0x00000003
delay 0x000000c8
0x21000024 = 0x00000001
delay 0x000000c8
delay 0x000000c8
delay 0x000000c8
end
