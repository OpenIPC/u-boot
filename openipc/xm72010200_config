CONFIG_SYS_SOC="xm72010200"
CONFIG_SYS_BOARD="xm72010200"
CONFIG_SYS_CONFIG_NAME="xm72010200"
# CONFIG_TARGET_XM72050200 is not set
CONFIG_TARGET_XM72010200=y
CONFIG_IDENT_STRING="xm72010200"
CONFIG_SYS_LOAD_ADDR=0x42000000
CONFIG_MMC=y
CONFIG_CMD_MMC=y
CONFIG_MMC_SDHCI=y

# The split NOR layout: the kernel (OpenIPC/linux goke-gk7205v500)
# divides one firmware partition from its own device tree.
CONFIG_OPENIPC_NOR_SPLIT=y
