# GK7101 boot ROM set-up: the register writes the mask ROM makes before it
# copies U-Boot into DDR -- eFuse, DDR PHY, the RCT and the DDR controller.
# Taken word for word from the boot header of a GK7101 camera's vendor
# U-Boot ("U-Boot 2012.10-svn1551 (Apr 12 2017) for GK7101 rb ov2710
# v2.20"). The SDK's prebuilt uboot-gk7101-rb-ov2710_v2.2.bin of 2016
# tunes the DDR PHY and controller as for the GK7102 (0x60021A60-6C,
# 0x60004018/1C) and starts the eFuse load without waiting for it; with
# that table the camera showed no console output. build.sh writes this
# table into the boot header.
#
#   version: <word>                  header word 1
#   ddrtest: <address> = <pattern>   header words 5 and 6
#   setup: <register> = <value>      write
#   rdcom: <register> = <value>      wait until the register reads <value>
#   delay: <count>                   wait
#
version: 0x30310801
ddrtest: 0xC4000000 = 0x5A5A5A5A
#
setup: 0x60021A6C = 0x00008000
setup: 0x60021A68 = 0x00000200
setup: 0x60021A60 = 0x0000DF3B
setup: 0x60021A64 = 0x00000033
setup: 0x60021A48 = 0x00001000
setup: 0x60021A48 = 0x00000000
setup: 0x60021B00 = 0x00000031
setup: 0x60021A00 = 0x00000012
setup: 0x60021A08 = 0x0000F080
setup: 0x60021A70 = 0x00000033
setup: 0x60021A74 = 0x00000000
setup: 0x60021A04 = 0x00000000
setup: 0x60021A78 = 0x00000200
setup: 0x60021A7C = 0x00000022
setup: 0x60021A1C = 0x000000E7
setup: 0x60021A1C = 0x000000A7
setup: 0x60021A1C = 0x000000E7
setup: 0x60021A1C = 0x000000A7
setup: 0x60021ADC = 0x00009999
setup: 0x60021AE4 = 0x00000006
setup: 0x60021AD4 = 0x0000004F
setup: 0x60021AD0 = 0x0000004F
setup: 0x60021AA8 = 0x00000000
setup: 0x60021A2C = 0x00000000
setup: 0x60021A00 = 0x00000002
setup: 0x60021A04 = 0x0000AAAA
setup: 0x60021A10 = 0x0000007F
setup: 0x70170228 = 0x00000001
setup: 0x60004004 = 0x00100354
setup: 0x60004008 = 0x48FA368B
setup: 0x6000400C = 0x00002872
setup: 0x60004010 = 0x0020903F
setup: 0x60004020 = 0x000000A0
setup: 0x60004000 = 0x00000004
setup: 0x60004014 = 0x00000001
rdcom: 0x60004014 = 0x00000000
setup: 0x60004018 = 0x01020000
rdcom: 0x60004018 = 0x01020000
setup: 0x60004018 = 0x01030000
rdcom: 0x60004018 = 0x01030000
setup: 0x60004018 = 0x01010044
rdcom: 0x60004018 = 0x01010044
setup: 0x60004018 = 0x01000B63
rdcom: 0x60004018 = 0x01000B63
setup: 0x60004014 = 0x00000001
rdcom: 0x60004014 = 0x00000000
setup: 0x60004014 = 0x00000002
rdcom: 0x60004014 = 0x00000000
setup: 0x60004014 = 0x00000002
rdcom: 0x60004014 = 0x00000000
setup: 0x60004014 = 0x00000002
rdcom: 0x60004014 = 0x00000000
setup: 0x60004018 = 0x01000A63
rdcom: 0x60004018 = 0x01000A63
setup: 0x60004000 = 0x00000006
setup: 0x60004018 = 0x01010380
rdcom: 0x60004018 = 0x01010380
setup: 0x60004018 = 0x01010002
rdcom: 0x60004018 = 0x01010002
setup: 0x6000401C = 0x0000002A
setup: 0x60004000 = 0x00000007
setup: 0x6000B104 = 0x00000001
rdcom: 0x6000B104 = 0x00000003
setup: 0x7000914C = 0x00000011
