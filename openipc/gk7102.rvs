# GK7102 boot ROM set-up: the register writes the mask ROM makes before it
# copies U-Boot into DDR -- eFuse, DDR PHY, the RCT and the DDR controller.
# Taken from the header of the SDK's prebuilt uboot-gk7102-rb-jxh42_v2.0.bin
# (GK710X_LinuxSDK_v2.0.0 boot/prebuild), the table on GK710x cameras in the
# field. build.sh writes it into the boot header.
#
#   version: <word>                  header word 1
#   ddrtest: <address> = <pattern>   header words 5 and 6
#   setup: <register> = <value>      write
#   rdcom: <register> = <value>      wait until the register reads <value>
#   delay: <count>                   wait
#
version: 0x30310801
ddrtest: 0xC4000000 = 0x5A5A5A5A
#
setup: 0x6000B100 = 0xFF39C119
setup: 0x60021A68 = 0x00000300
setup: 0x60021A60 = 0x00002B52
setup: 0x60021A64 = 0x00000035
setup: 0x60021A48 = 0x00001000
setup: 0x60021A48 = 0x00000000
