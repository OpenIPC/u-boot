# The base of every Rockchip target's .config: build.sh concatenates this,
# openipc/<soc>_config, openipc/nand_config for SPI NAND images and
# CONFIG_PRODUCT_SOC, then runs olddefconfig; a later line overrides an
# earlier one.
CONFIG_ARM=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_NR_DRAM_BANKS=1
CONFIG_COUNTER_FREQUENCY=24000000
CONFIG_SYS_ARCH_TIMER=y
# CONFIG_ROCKCHIP_STIMER is not set
CONFIG_OF_CONTROL=y
CONFIG_OF_SEPARATE=y
CONFIG_OF_LIBFDT=y
CONFIG_DM=y
# mainline's Rockchip cpu-info expects another CRU layout
# CONFIG_DISPLAY_CPUINFO is not set
CONFIG_MISC_INIT_R=y
CONFIG_FIT=y
CONFIG_LEGACY_IMAGE_FORMAT=y
# CONFIG_EFI_LOADER is not set
CONFIG_SYS_THUMB_BUILD=y
# CONFIG_BOOTSTD is not set
# CONFIG_DISTRO_DEFAULTS is not set
# CONFIG_SYS_LONGHELP is not set
# CONFIG_REGEX is not set
# CONFIG_ENV_IS_NOWHERE is not set
CONFIG_SYSRESET=y
CONFIG_REGMAP=y
CONFIG_SYSCON=y
CONFIG_CLK=y
CONFIG_BOUNCE_BUFFER=y

# SPL: mainline's Rockchip SPL (spl.c, spl-boot-order.c), behind the DDR
# blob in the ID block; it loads u-boot.itb (U-Boot and its device tree,
# both LZMA) from the boot partition
CONFIG_SPL=y
CONFIG_SPL_FRAMEWORK=y
CONFIG_SPL_ROCKCHIP_COMMON_BOARD=y
CONFIG_SPL_SERIAL=y
CONFIG_SPL_DM=y
CONFIG_SPL_OF_CONTROL=y
CONFIG_SPL_LIBCOMMON_SUPPORT=y
CONFIG_SPL_LIBGENERIC_SUPPORT=y
CONFIG_SPL_SYS_MALLOC_F_LEN=0x4000
CONFIG_SPL_REGMAP=y
CONFIG_SPL_SYSCON=y
CONFIG_SPL_CLK=y
# CONFIG_SPL_PINCTRL is not set
CONFIG_SPL_FIT=y
CONFIG_SPL_LOAD_FIT=y
CONFIG_SPL_LZMA=y
# build.sh packs the ID block and binman only u-boot.itb
# CONFIG_SPL_BINMAN_SYMBOLS is not set

# Console: UART2 (DesignWare APB), 115200 from 24 MHz
CONFIG_DM_SERIAL=y
CONFIG_SYS_NS16550=y
CONFIG_BAUDRATE=115200
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_NS16550=y
CONFIG_DEBUG_UART_CLOCK=24000000
CONFIG_DEBUG_UART_SHIFT=2
CONFIG_SYS_PROMPT="OpenIPC # "
CONFIG_HUSH_PARSER=y
CONFIG_CMDLINE_EDITING=y
CONFIG_AUTO_COMPLETE=y

# Autoboot: Ctrl-C only
CONFIG_BOOTDELAY=1
CONFIG_AUTOBOOT=y
CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_PROMPT="Hit Ctrl-C to stop autoboot: %2d\n"
CONFIG_AUTOBOOT_STOP_STR="\x03"
CONFIG_AUTOBOOT_KEYED_CTRLC=y

# OpenIPC boot layer: firmware scan, recovery, boot-limit failsafe
CONFIG_OPENIPC=y
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_GENERIC=y
CONFIG_SYS_BOOTCOUNT_SINGLEWORD=y

# Flash: the SFC, SPI NOR (openipc/nand_config: SPI NAND)
CONFIG_SPI=y
CONFIG_DM_SPI=y
CONFIG_SPI_MEM=y
CONFIG_ROCKCHIP_SFC=y
CONFIG_DM_SPI_FLASH=y
CONFIG_SPI_FLASH=y
CONFIG_SPI_FLASH_GIGADEVICE=y
CONFIG_SPI_FLASH_MACRONIX=y
CONFIG_SPI_FLASH_WINBOND=y
CONFIG_SPI_FLASH_XMC=y
CONFIG_SPI_FLASH_XTX=y
CONFIG_SPI_FLASH_SFDP_SUPPORT=y
CONFIG_ENV_IS_IN_SPI_FLASH=y
CONFIG_ENV_OFFSET=0x40000
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_SECT_SIZE=0x10000
CONFIG_CMD_SF=y
CONFIG_SPL_SPI=y
CONFIG_SPL_SPI_FLASH_SUPPORT=y
CONFIG_SPL_SPI_LOAD=y
CONFIG_SPL_DM_SPI=y
CONFIG_SPL_SPI_MEM=y
CONFIG_SPL_DM_SPI_FLASH=y
# u-boot.itb, behind the ID block at 0x8000 (72 KiB: the DDR blob and the
# SPL); build.sh checks that neither overruns
CONFIG_SYS_SPI_U_BOOT_OFFS=0x1a000

# Commands
CONFIG_CMD_BOOTM=y
CONFIG_CMD_BOOTZ=y
CONFIG_CMD_GO=y
CONFIG_CMD_RUN=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_ITEST=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_EDITENV=y
CONFIG_CMD_SAVEENV=y
CONFIG_CMD_ENV_EXISTS=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_CRC32=y
CONFIG_CMD_SLEEP=y
# CONFIG_CMD_BDI is not set
# CONFIG_CMD_ELF is not set
# CONFIG_CMD_IMI is not set
# CONFIG_CMD_XIMG is not set
# CONFIG_CMD_FLASH is not set
# CONFIG_CMD_LOADS is not set
# Not used by the environment, and not on openipc-hisilicon: room on the
# 256 KiB NOR boot partition
# CONFIG_CMD_NFS is not set
# CONFIG_CMD_DM is not set
# CONFIG_CMD_PINMUX is not set
# CONFIG_CMD_BOOTZ is not set
# CONFIG_CMD_BLOCK_CACHE is not set
# CONFIG_MMC_HW_PARTITIONING is not set
# CONFIG_MMC_VERBOSE is not set
# No gzip: OpenIPC's Rockchip kernels are zImages, which decompress
# themselves (a FIT or uImage holds them uncompressed), and nothing in the
# environment unzips. Room on the NOR boot partition (RV1126: 5.8 KiB).
# CONFIG_GZIP is not set
