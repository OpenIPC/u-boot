# OpenIPC base configuration for the Allwinner V831/V833 targets. build.sh
# appends the per-SoC fragment and runs olddefconfig, so a later line
# overrides an earlier one.
CONFIG_ARM=y
CONFIG_ARCH_SUNXI=y
CONFIG_MACH_SUN8I_V831=y
CONFIG_DEFAULT_DEVICE_TREE="sun8i-v831-openipc"
CONFIG_IDENT_STRING=" Allwinner V83x"
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# 32 MiB into the DDR: below what the smallest part (64 MiB) has
CONFIG_SYS_TEXT_BASE=0x42000000
CONFIG_SYS_LOAD_ADDR=0x41000000
CONFIG_SYS_MALLOC_F_LEN=0x2000
CONFIG_SYS_MALLOC_LEN=0x400000
CONFIG_NR_DRAM_BANKS=1
CONFIG_DISPLAY_CPUINFO=y
CONFIG_DISPLAY_BOARDINFO=y
CONFIG_MISC_INIT_R=y
# CONFIG_BOARD_LATE_INIT is not set

# SPL: the boot ROM loads it from SPI NOR offset 0 (eGON.BT0) into SRAM;
# it brings up clocks and DDR, then loads U-Boot from offset 0x8000
CONFIG_SPL=y
# end of SRAM A2, as on the H6
CONFIG_SPL_STACK=0x118000
CONFIG_SPL_SPI_SUNXI=y
CONFIG_SYS_SPI_U_BOOT_OFFS=0x8000
# U-Boot is LZMA-packed (build.sh), to fit the 256 KiB boot partition
CONFIG_SPL_LZMA=y
# CONFIG_SPL_MMC is not set
# CONFIG_SPL_FS_FAT is not set
# CONFIG_SPL_LIBDISK_SUPPORT is not set
# CONFIG_SPL_POWER is not set
# CONFIG_SPL_I2C is not set
# CONFIG_SPL_DOS_PARTITION is not set
# CONFIG_SPL_EFI_PARTITION is not set

# Kernel hand-off: non-secure, PSCI 1.0 from U-Boot's own monitor, as
# the vendor kernels expect from OP-TEE
CONFIG_ARMV7_NONSEC=y
CONFIG_ARMV7_PSCI=y
CONFIG_ARMV7_PSCI_1_0=y
CONFIG_ARMV7_PSCI_NR_CPUS=1

# Console: UART0
CONFIG_CONS_INDEX=1
CONFIG_BAUDRATE=115200
CONFIG_SYS_PROMPT="OpenIPC # "
CONFIG_SILENT_CONSOLE=y
CONFIG_SILENT_CONSOLE_UPDATE_ON_RELOC=y
CONFIG_HUSH_PARSER=y
CONFIG_CMDLINE_EDITING=y
CONFIG_AUTO_COMPLETE=y

# Autoboot: Ctrl-C only
CONFIG_BOOTDELAY=1
CONFIG_AUTOBOOT=y
CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_PROMPT="Hit Ctrl-C to stop autoboot: %2d\n"
CONFIG_AUTOBOOT_STOP_STR="\x03"
CONFIG_AUTOBOOT_KEYED_CTRLC=y
# CONFIG_DISTRO_DEFAULTS is not set
# CONFIG_USE_PREBOOT is not set

# OpenIPC boot layer: firmware scan, recovery, boot-limit failsafe
CONFIG_OPENIPC=y
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_GENERIC=y
CONFIG_SYS_BOOTCOUNT_SINGLEWORD=y
# DRAM + 0x1f20000, as on the other targets
CONFIG_SYS_BOOTCOUNT_ADDR=0x41F20000
CONFIG_LEGACY_IMAGE_FORMAT=y
# CONFIG_FIT is not set

# Kernels boot with the vendor device tree U-Boot carries (board/sunxi)
CONFIG_OF_LIBFDT=y
# CONFIG_OF_LIBFDT_OVERLAY is not set

# SD card (SMHC0, 4-bit): recovery from it in common/openipc.c, fatload
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_CMD_MMC=y
CONFIG_CMD_FAT=y
CONFIG_FS_FAT=y
CONFIG_DOS_PARTITION=y
# CONFIG_MMC_HW_PARTITIONING is not set
# CONFIG_SUPPORT_EMMC_BOOT is not set
# CONFIG_EFI_PARTITION is not set
# CONFIG_FAT_WRITE is not set

# SPI NOR, and the environment in it
CONFIG_SPI=y
CONFIG_SPI_SUNXI=y
CONFIG_SPI_FLASH=y
CONFIG_SPI_FLASH_BAR=y
CONFIG_SPI_FLASH_EON=y
CONFIG_SPI_FLASH_GIGADEVICE=y
CONFIG_SPI_FLASH_ISSI=y
CONFIG_SPI_FLASH_MACRONIX=y
CONFIG_SPI_FLASH_SPANSION=y
CONFIG_SPI_FLASH_WINBOND=y
CONFIG_SPI_FLASH_XMC=y
CONFIG_SPI_FLASH_XTX=y
CONFIG_CMD_SF=y
CONFIG_ENV_IS_IN_SPI_FLASH=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_EXT4 is not set
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_ENV_IS_NOWHERE is not set
CONFIG_ENV_OFFSET=0x40000
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_SECT_SIZE=0x10000
# SPL, U-Boot and its device trees must end before the environment:
# build.sh fails the build, not the board
# CONFIG_HAS_BOARD_SIZE_LIMIT is not set

# Commands
CONFIG_CMD_BOOTM=y
CONFIG_CMD_GO=y
CONFIG_CMD_RUN=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_ITEST=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_EDITENV=y
CONFIG_CMD_SAVEENV=y
CONFIG_CMD_ENV_EXISTS=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_CRC32=y
CONFIG_CMD_SLEEP=y
CONFIG_CMD_FDT=y
# Not used by the OpenIPC flows
# CONFIG_CMD_BOOTEFI is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_CMD_BOOTZ is not set
# CONFIG_CMD_ELF is not set
# CONFIG_CMD_XIMG is not set
# CONFIG_CMD_RANDOM is not set
# CONFIG_CMD_LOADS is not set
# CONFIG_CMD_NFS is not set
# CONFIG_CMD_GPT is not set
# CONFIG_CMD_GPIO is not set
# CONFIG_CMD_DM is not set
# CONFIG_CMD_PXE is not set
# CONFIG_CMD_EXTENSION is not set
# CONFIG_CMD_IMI is not set
# CONFIG_CMD_FPGA is not set
# CONFIG_CMD_LZMADEC is not set
# CONFIG_CMD_UNZIP is not set
# CONFIG_CMD_BOOTDEV is not set

# Not on these boards
# CONFIG_USB is not set
# CONFIG_USB_GADGET is not set
# CONFIG_VIDEO is not set
# CONFIG_DM_VIDEO is not set
# CONFIG_VIDEO_DE2 is not set
# CONFIG_I2C is not set
# CONFIG_DM_I2C is not set
# CONFIG_SYSRESET is not set
# CONFIG_WDT is not set
# CONFIG_DM_KEYBOARD is not set
# CONFIG_PHY_SUN4I_USB is not set
# CONFIG_SUNXI_NO_PMIC is not set

# Network: the EMAC, RMII to an external PHY
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_SUN8I_EMAC=y
CONFIG_PHYLIB=y
CONFIG_DM_MDIO=y
CONFIG_CMD_NET=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_CMD_MII=y
CONFIG_NET_RANDOM_ETHADDR=y
CONFIG_LIB_RAND=y
