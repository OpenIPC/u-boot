# OpenIPC base configuration for the Grain Media targets. build.sh appends
# the per-SoC fragment and runs olddefconfig, so a later line overrides an
# earlier one.
CONFIG_ARM=y
CONFIG_ARCH_GRAINMEDIA=y
# nsboot loads U-Boot to DDR 0 and jumps there
CONFIG_SYS_TEXT_BASE=0x0
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_DM is not set
CONFIG_SYS_DCACHE_OFF=y
CONFIG_SYS_MALLOC_F_LEN=0x2000
CONFIG_SYS_MALLOC_LEN=0x400000
CONFIG_SYS_LOAD_ADDR=0x01000000
CONFIG_NR_DRAM_BANKS=1
CONFIG_STATIC_MACH_TYPE=y
# What the vendor kernel registers ("GM")
CONFIG_MACH_TYPE=758
CONFIG_SETUP_MEMORY_TAGS=y
CONFIG_CMDLINE_TAG=y
CONFIG_INITRD_TAG=y
CONFIG_DISPLAY_CPUINFO=y
CONFIG_MISC_INIT_R=y

# Console: UART0, a 16550
CONFIG_SYS_NS16550=y
CONFIG_SPECIFY_CONSOLE_INDEX=y
CONFIG_CONS_INDEX=1
CONFIG_BAUDRATE=115200
CONFIG_SYS_PROMPT="OpenIPC # "
CONFIG_SILENT_CONSOLE=y
CONFIG_SILENT_CONSOLE_UPDATE_ON_RELOC=y
CONFIG_HUSH_PARSER=y
CONFIG_CMDLINE_EDITING=y
CONFIG_AUTO_COMPLETE=y

# Autoboot: Ctrl-C only
CONFIG_BOOTDELAY=1
CONFIG_AUTOBOOT=y
CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_PROMPT="Hit Ctrl-C to stop autoboot: %2d\n"
CONFIG_AUTOBOOT_STOP_STR="\x03"
CONFIG_AUTOBOOT_KEYED_CTRLC=y

# OpenIPC boot layer: firmware scan, recovery, boot-limit failsafe
CONFIG_OPENIPC=y
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_GENERIC=y
CONFIG_SYS_BOOTCOUNT_SINGLEWORD=y
# DRAM + 0x1f20000, as on the other targets
CONFIG_SYS_BOOTCOUNT_ADDR=0x01F20000
CONFIG_LEGACY_IMAGE_FORMAT=y
CONFIG_OF_LIBFDT=y

# SPI NOR on the FTSPI020 through the spi-nor layer, and the environment
CONFIG_SPI=y
CONFIG_FTSPI020=y
CONFIG_SPI_FLASH=y
CONFIG_SF_DEFAULT_SPEED=30000000
CONFIG_SF_DEFAULT_MODE=0x3
# CONFIG_SPI_FLASH_SFDP_SUPPORT is not set
CONFIG_SPI_FLASH_EON=y
CONFIG_SPI_FLASH_GIGADEVICE=y
CONFIG_SPI_FLASH_ISSI=y
CONFIG_SPI_FLASH_MACRONIX=y
CONFIG_SPI_FLASH_SPANSION=y
CONFIG_SPI_FLASH_WINBOND=y
CONFIG_SPI_FLASH_XMC=y
CONFIG_SPI_FLASH_XTX=y
CONFIG_CMD_SF=y
CONFIG_ENV_IS_IN_SPI_FLASH=y
CONFIG_ENV_OFFSET=0x40000
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_SECT_SIZE=0x10000
# U-Boot sits at 0x8000, after nsboot's 24 KiB at most, and must end
# before the environment; gm-image.py checks it again
CONFIG_HAS_BOARD_SIZE_LIMIT=y
CONFIG_BOARD_SIZE_LIMIT=229376

# Commands
CONFIG_CMD_BOOTM=y
CONFIG_CMD_GO=y
CONFIG_CMD_RUN=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_ITEST=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_EDITENV=y
CONFIG_CMD_SAVEENV=y
CONFIG_CMD_ENV_EXISTS=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_CRC32=y
CONFIG_CMD_SLEEP=y

# SD card: recovery images and scripts (common/openipc.c)
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
# CONFIG_MMC_HW_PARTITIONING is not set
CONFIG_CMD_MMC=y
CONFIG_DOS_PARTITION=y
CONFIG_FS_FAT=y
CONFIG_CMD_FAT=y

# Room for it below the environment: link-time optimisation, and no
# commands the OpenIPC flows have no use for here (the kernel takes no
# device tree)
CONFIG_LTO=y
# CONFIG_CMD_FDT is not set
# CONFIG_CMD_ELF is not set
# CONFIG_CMD_XIMG is not set
# CONFIG_CMD_NFS is not set
# CONFIG_CMD_IMPORTENV is not set
# CONFIG_CMD_EXPORTENV is not set
# CONFIG_CMD_CONSOLE is not set
# CONFIG_CMD_LOADB is not set
# CONFIG_CMD_LOADS is not set
# CONFIG_CMD_BDI is not set
# CONFIG_CMD_IMI is not set
# CONFIG_CMD_RANDOM is not set
# CONFIG_MMC_VERBOSE is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_EFI_PARTITION is not set

# Network: the FTGMAC100 on RMII
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_FTGMAC100_NODM=y
CONFIG_CMD_NET=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_NET_RANDOM_ETHADDR=y
CONFIG_LIB_RAND=y
