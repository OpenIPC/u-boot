# OpenIPC base configuration for the Anyka AK39 targets. build.sh
# appends the per-SoC fragment and runs olddefconfig, so a later line
# overrides an earlier one.
CONFIG_ARM=y
CONFIG_ARCH_ANYKA=y
# Where the boot ROM loads U-Boot on EV200/EV300; ak39ev330_config moves it
CONFIG_SYS_TEXT_BASE=0x80E00000
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_DM is not set
CONFIG_SYS_DCACHE_OFF=y
CONFIG_SYS_MALLOC_F_LEN=0x2000
CONFIG_SYS_MALLOC_LEN=0x400000
CONFIG_SYS_LOAD_ADDR=0x82000000
CONFIG_NR_DRAM_BANKS=1
CONFIG_STATIC_MACH_TYPE=y
# ANYKA_AK39XX: what every vendor board file registers
CONFIG_MACH_TYPE=3892
CONFIG_SETUP_MEMORY_TAGS=y
CONFIG_CMDLINE_TAG=y
CONFIG_INITRD_TAG=y
CONFIG_DISPLAY_CPUINFO=y
CONFIG_MISC_INIT_R=y

# Console: UART0, through L2 memory
CONFIG_AK39_SERIAL=y
CONFIG_BAUDRATE=115200
CONFIG_SYS_PROMPT="OpenIPC # "
CONFIG_SILENT_CONSOLE=y
CONFIG_SILENT_CONSOLE_UPDATE_ON_RELOC=y
CONFIG_HUSH_PARSER=y
CONFIG_CMDLINE_EDITING=y
CONFIG_AUTO_COMPLETE=y

# Autoboot: Ctrl-C only
CONFIG_BOOTDELAY=1
CONFIG_AUTOBOOT=y
CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_PROMPT="Hit Ctrl-C to stop autoboot: %2d\n"
CONFIG_AUTOBOOT_STOP_STR="\x03"
CONFIG_AUTOBOOT_KEYED_CTRLC=y

# OpenIPC boot layer: firmware scan, recovery, boot-limit failsafe
CONFIG_OPENIPC=y
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_GENERIC=y
CONFIG_SYS_BOOTCOUNT_SINGLEWORD=y
# DRAM + 0x1f20000, as on the HiSilicon and Xiongmai targets
CONFIG_SYS_BOOTCOUNT_ADDR=0x81F20000
CONFIG_LEGACY_IMAGE_FORMAT=y
CONFIG_OF_LIBFDT=y

# No SD driver yet: SD recovery in common/openipc.c is compiled out
# CONFIG_MMC is not set

# SPI NOR, and the environment in it
CONFIG_AK_SFLASH=y
CONFIG_CMD_SF=y
CONFIG_ENV_IS_IN_SPI_FLASH=y
CONFIG_ENV_OFFSET=0x40000
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_SECT_SIZE=0x10000
# Boot header (512 bytes) + image must end before the environment: fail the
# build, not the board. ak39ev330_config has the EV330's own limit.
CONFIG_HAS_BOARD_SIZE_LIMIT=y
CONFIG_BOARD_SIZE_LIMIT=261632

# Commands
CONFIG_CMD_BOOTM=y
CONFIG_CMD_GO=y
CONFIG_CMD_RUN=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_ITEST=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_EDITENV=y
CONFIG_CMD_SAVEENV=y
CONFIG_CMD_ENV_EXISTS=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_CRC32=y
CONFIG_CMD_SLEEP=y

# Network: the GMAC is a DesignWare MAC, RMII to an external PHY
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_ETH_DESIGNWARE=y
CONFIG_PHYLIB=y
CONFIG_CMD_NET=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_CMD_MII=y
CONFIG_NET_RANDOM_ETHADDR=y
CONFIG_LIB_RAND=y
