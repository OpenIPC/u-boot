# OpenIPC base configuration for the Ingenic T-series targets. build.sh
# appends the per-SoC fragment and runs olddefconfig, so a later line
# overrides an earlier one.
CONFIG_MIPS=y
CONFIG_ARCH_INGENIC=y
CONFIG_SYS_LITTLE_ENDIAN=y
CONFIG_CPU_MIPS32_R2=y
# Where the SPL unpacks U-Boot, as the vendor U-Boot is linked
CONFIG_SYS_TEXT_BASE=0x80100000
CONFIG_SKIP_LOWLEVEL_INIT=y
# CONFIG_MIPS_CACHE_SETUP is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_DM is not set
CONFIG_SYS_MALLOC_LEN=0x2000000
# The kernel command line and environment, from the malloc pool as the
# vendor U-Boot reserved them; without it they would go to address 0
CONFIG_SYS_MALLOC_BOOTPARAMS=y
CONFIG_SYS_BOOTPARAMS_LEN=0x40000
CONFIG_SYS_LOAD_ADDR=0x80600000
CONFIG_SYS_BOOTM_LEN=0x1000000
CONFIG_NR_DRAM_BANKS=1
CONFIG_DISPLAY_CPUINFO=y
CONFIG_DISPLAY_BOARDINFO=y
CONFIG_BOARD_EARLY_INIT_F=y
CONFIG_MISC_INIT_R=y
CONFIG_LAST_STAGE_INIT=y

# SPL: in the cache the boot ROM locks as RAM, 26 KiB at most
CONFIG_SPL=y
CONFIG_SPL_TEXT_BASE=0x80001000
CONFIG_SPL_MAX_SIZE=0x6800
CONFIG_SPL_LDSCRIPT="arch/mips/mach-ingenic/u-boot-spl.lds"
# CONFIG_SPL_FRAMEWORK is not set
CONFIG_SPL_SERIAL=y
CONFIG_SPL_LIBCOMMON_SUPPORT=y
CONFIG_SPL_LIBGENERIC_SUPPORT=y
CONFIG_SPL_LZO=y
CONFIG_SPL_USE_TINY_PRINTF=y
# CONFIG_SPL_SYS_MALLOC_SIMPLE is not set
# CONFIG_SPL_BANNER_PRINT is not set
# The BSS shares the cache RAM with the code, under SPL_MAX_SIZE
CONFIG_SPL_NO_BSS_LIMIT=y

# Console: UART1 (arch/mips/mach-ingenic/jz_serial.c)
CONFIG_BAUDRATE=115200
CONFIG_SYS_PROMPT="OpenIPC # "
CONFIG_HUSH_PARSER=y
CONFIG_CMDLINE_EDITING=y
CONFIG_AUTO_COMPLETE=y
CONFIG_SYS_CBSIZE=2048
CONFIG_SYS_MAXARGS=64

# Autoboot: Ctrl-C only
CONFIG_BOOTDELAY=1
CONFIG_AUTOBOOT=y
CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_PROMPT="Hit Ctrl-C to stop autoboot: %2d\n"
CONFIG_AUTOBOOT_STOP_STR="\x03"
CONFIG_AUTOBOOT_KEYED_CTRLC=y

# OpenIPC boot layer: firmware scan, recovery, boot-limit failsafe
CONFIG_OPENIPC=y
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_GENERIC=y
CONFIG_SYS_BOOTCOUNT_SINGLEWORD=y
# DRAM + 0x1f20000, as on the other targets
CONFIG_SYS_BOOTCOUNT_ADDR=0x81F20000
CONFIG_LEGACY_IMAGE_FORMAT=y
CONFIG_LZMA=y
CONFIG_LZO=y
CONFIG_OF_LIBFDT=y

# SPI NOR on the SFC, and the environment in it
CONFIG_JZ_SFC_NOR=y
CONFIG_CMD_SF=y
CONFIG_ENV_IS_IN_SPI_FLASH=y
CONFIG_ENV_OFFSET=0x40000
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_SECT_SIZE=0x10000

# SD card (MSC0): recovery from it in common/openipc.c, fatload
CONFIG_MMC=y
CONFIG_JZ_MMC=y
CONFIG_CMD_MMC=y
CONFIG_CMD_FAT=y
CONFIG_FS_FAT=y
CONFIG_DOS_PARTITION=y
# CONFIG_MMC_HW_PARTITIONING is not set
# CONFIG_SUPPORT_EMMC_BOOT is not set
# CONFIG_EFI_PARTITION is not set

# Commands
CONFIG_CMD_BOOTM=y
CONFIG_CMD_GO=y
CONFIG_CMD_RUN=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_ITEST=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_EDITENV=y
CONFIG_CMD_SAVEENV=y
CONFIG_CMD_ENV_EXISTS=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_CRC32=y
CONFIG_CMD_SLEEP=y
CONFIG_CMD_GPIO=y
# Not used by the OpenIPC flows
# CONFIG_CMD_FDT is not set
# CONFIG_CMD_ELF is not set
# CONFIG_CMD_XIMG is not set
# CONFIG_CMD_RANDOM is not set
# CONFIG_CMD_LOADS is not set
# CONFIG_CMD_NFS is not set

# Network: the GMAC
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_JZ_GMAC=y
CONFIG_CMD_NET=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_CMD_TFTPPUT=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_CMD_MII=y
CONFIG_NET_RANDOM_ETHADDR=y
CONFIG_LIB_RAND=y
