# OpenIPC base configuration for the Novatek NA51089 targets. build.sh
# appends the per-SoC fragment and runs olddefconfig, so a later line
# overrides an earlier one.
CONFIG_ARM=y
CONFIG_ARCH_NOVATEK=y
# Where the loader's device tree (/nvt_memory_cfg/uboot) has U-Boot
# unpacked and started: the HEADINFO's CodeEntry must say the same
CONFIG_SYS_TEXT_BASE=0x03900000
CONFIG_SKIP_LOWLEVEL_INIT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_DM is not set
CONFIG_SYS_DCACHE_OFF=y
CONFIG_SYS_MALLOC_F_LEN=0x2000
CONFIG_SYS_MALLOC_LEN=0x400000
CONFIG_SYS_LOAD_ADDR=0x01000000
CONFIG_NR_DRAM_BANKS=1
CONFIG_DISPLAY_CPUINFO=y
CONFIG_MISC_INIT_R=y

# Console: UART0, a 16550
CONFIG_SYS_NS16550=y
CONFIG_SPECIFY_CONSOLE_INDEX=y
CONFIG_CONS_INDEX=1
CONFIG_BAUDRATE=115200
CONFIG_SYS_PROMPT="OpenIPC # "
CONFIG_SILENT_CONSOLE=y
CONFIG_SILENT_CONSOLE_UPDATE_ON_RELOC=y
CONFIG_HUSH_PARSER=y
CONFIG_CMDLINE_EDITING=y
CONFIG_AUTO_COMPLETE=y

# Autoboot: Ctrl-C only
CONFIG_BOOTDELAY=1
CONFIG_AUTOBOOT=y
CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_PROMPT="Hit Ctrl-C to stop autoboot: %2d\n"
CONFIG_AUTOBOOT_STOP_STR="\x03"
CONFIG_AUTOBOOT_KEYED_CTRLC=y

# OpenIPC boot layer: firmware scan, recovery, boot-limit failsafe
CONFIG_OPENIPC=y
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_GENERIC=y
CONFIG_SYS_BOOTCOUNT_SINGLEWORD=y
# DRAM + 0x1f20000, as on the other targets
CONFIG_SYS_BOOTCOUNT_ADDR=0x01F20000
CONFIG_LEGACY_IMAGE_FORMAT=y

# Kernels boot with the loader's device tree (board/novatek/na51089)
CONFIG_OF_LIBFDT=y
CONFIG_OF_BOARD_SETUP=y

# SD card (SDIO1, 4-bit): recovery from it in common/openipc.c, fatload
CONFIG_MMC=y
CONFIG_MMC_NVT=y
CONFIG_CMD_MMC=y
CONFIG_CMD_FAT=y
CONFIG_FS_FAT=y
CONFIG_DOS_PARTITION=y
# CONFIG_MMC_HW_PARTITIONING is not set
# CONFIG_SUPPORT_EMMC_BOOT is not set
# CONFIG_EFI_PARTITION is not set

# SPI NOR, and the environment in it
CONFIG_NVT_SFLASH=y
CONFIG_CMD_SF=y
CONFIG_ENV_IS_IN_SPI_FLASH=y
CONFIG_ENV_OFFSET=0x40000
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_SECT_SIZE=0x10000

# Commands
CONFIG_CMD_BOOTM=y
CONFIG_CMD_GO=y
CONFIG_CMD_RUN=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_ITEST=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_EDITENV=y
CONFIG_CMD_SAVEENV=y
CONFIG_CMD_ENV_EXISTS=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_CRC32=y
CONFIG_CMD_SLEEP=y
# Not used by the OpenIPC flows
# CONFIG_CMD_ELF is not set
# CONFIG_CMD_XIMG is not set
# CONFIG_CMD_RANDOM is not set
# CONFIG_CMD_LOADS is not set
# CONFIG_CMD_NFS is not set

# Network: the Ethernet QoS MAC, on the embedded PHY or RMII as the
# loader's device tree says (board/novatek/na51089)
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_NVT_EQOS=y
CONFIG_PHYLIB=y
CONFIG_CMD_NET=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_CMD_MII=y
CONFIG_NET_RANDOM_ETHADDR=y
CONFIG_LIB_RAND=y
