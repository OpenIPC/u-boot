# Rockchip RV1106 / RV1103: DRAM at 0, the SPL at 0 (the mask ROM puts it
# there), U-Boot at 2 MiB
CONFIG_ROCKCHIP_RV1106=y
CONFIG_SPL_TEXT_BASE=0x00000000
CONFIG_SYS_TEXT_BASE=0x00200000
CONFIG_SYS_LOAD_ADDR=0x01000000
CONFIG_SYS_BOOTM_LEN=0x4000000
CONFIG_SYS_MALLOC_LEN=0x400000
CONFIG_SYS_MALLOC_F_LEN=0x2000
CONFIG_DEBUG_UART_BASE=0xff4c0000

# DRAM + 0x1f20000, as on the other targets
CONFIG_SYS_BOOTCOUNT_ADDR=0x01F20000
# The SPL: after init, its stack at 9 MiB and a 1 MiB simple heap below
# it, for the FIT and LZMA buffers, clear of the SPL, the ATAGs, and
# U-Boot at 2 MiB
CONFIG_SPL_SYS_MALLOC_SIMPLE=y
CONFIG_SPL_STACK_R=y
CONFIG_SPL_STACK_R_ADDR=0x900000
CONFIG_SPL_STACK_R_MALLOC_SIMPLE_LEN=0x100000

# Network: the Ethernet MAC, a DWC Ethernet QoS, with the SoC's own 10/100
# PHY on RMII
CONFIG_NET=y
CONFIG_DM_ETH=y
CONFIG_DWC_ETH_QOS=y
CONFIG_DWC_ETH_QOS_ROCKCHIP=y
CONFIG_PHYLIB=y
CONFIG_DM_RESET=y
CONFIG_RESET_ROCKCHIP=y
CONFIG_CMD_NET=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_NET_RANDOM_ETHADDR=y
# The SD card, for recovery and srcmmc (common/openipc.c): the DW MMC at
# 0xffaa0000 and its pins; the SPL boots only from the flash it came from
# CONFIG_SPL_MMC is not set
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ROCKCHIP=y
# CONFIG_SPL_PINCTRL is not set
CONFIG_CMD_MMC=y
CONFIG_DOS_PARTITION=y
CONFIG_FS_FAT=y
CONFIG_CMD_FAT=y
