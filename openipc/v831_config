# V831: 64 MiB of DDR2 in the package, the vendor's parameters (the
# v831 reference boards' sys_config.fex, the same on every V831 flash seen)
CONFIG_PRODUCT_SOC="v831"
CONFIG_MACH_SUN8I_V831=y
CONFIG_DEFAULT_DEVICE_TREE="sun8i-v831-openipc"
CONFIG_IDENT_STRING=" Allwinner V83x"
# SPL stack: the end of SRAM A2, as on the H6
CONFIG_SPL_STACK=0x118000
# Kernel hand-off: non-secure, PSCI 1.0 from U-Boot's own monitor, as
# the vendor kernels expect from OP-TEE
CONFIG_ARMV7_NONSEC=y
CONFIG_ARMV7_PSCI=y
CONFIG_ARMV7_PSCI_1_0=y
CONFIG_ARMV7_PSCI_NR_CPUS=1
CONFIG_DRAM_CLK=528
CONFIG_DRAM_ZQ=3065
CONFIG_DRAM_SUN8I_V831_TYPE=2
CONFIG_DRAM_SUN8I_V831_PARA1=0xd2
CONFIG_DRAM_SUN8I_V831_MR0=0xe73
CONFIG_DRAM_SUN8I_V831_MR1=0x2
CONFIG_DRAM_SUN8I_V831_MR2=0x0
CONFIG_DRAM_SUN8I_V831_TPR0=0x00471992
CONFIG_DRAM_SUN8I_V831_TPR1=0x0131a10c
CONFIG_DRAM_SUN8I_V831_TPR2=0x00057041
CONFIG_DRAM_SUN8I_V831_TPR11=0x00120000
CONFIG_DRAM_SUN8I_V831_TPR12=0x23
CONFIG_DRAM_SUN8I_V831_TPR13=0x34000903
