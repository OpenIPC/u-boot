# GK7102S / GK7102C boot ROM set-up: the register writes the mask ROM makes
# before it copies U-Boot into DDR -- clocks, DDR PHY and the DDR
# controller, at the GK710xS addresses. Taken from the boot header of the
# GK7102C camera dump roxiq.bin (vendor U-Boot 2012.10 "GK7102C
# devkit-v1.1", 2020). build.sh writes it into the boot header.
#
#   version: <word>                  header word 1
#   ddrtest: <address> = <pattern>   header words 5 and 6
#   setup: <register> = <value>      write
#   rdcom: <register> = <value>      wait until the register reads <value>
#   delay: <count>                   wait
#
version: 0x304308EF
ddrtest: 0xC1000000 = 0x5A5A5A5A
#
setup: 0xA0170118 = 0x00000002
setup: 0xA0170108 = 0x00100018
setup: 0xA017011C = 0x00100018
setup: 0xA0170000 = 0x00111024
setup: 0xA0170014 = 0x00113036
setup: 0xA0170198 = 0x00000011
setup: 0xA0170028 = 0x00000001
setup: 0xA000500C = 0x00000080
setup: 0xA0005000 = 0x0000000D
setup: 0xA000500C = 0x00000000
setup: 0xA000500C = 0x00000003
setup: 0xA0005000 = 0x0000000D
delay: 0x180
setup: 0xA0005000 = 0x0000000A
delay: 0x180
setup: 0xA0005000 = 0x0000002E
delay: 0x180
setup: 0xA0005000 = 0x0000000A
delay: 0x180
setup: 0xA0005000 = 0x0000000D
delay: 0x180
setup: 0xA0005000 = 0x0000000A
delay: 0x180
