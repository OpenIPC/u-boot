# Axera AX620U with SPI NAND. build.sh runs olddefconfig on this, so a
# later line overrides an earlier one.
CONFIG_ARM=y
CONFIG_ARCH_AXERA=y
CONFIG_AXERA_AX620U=y
CONFIG_PRODUCT_SOC="ax620u"
# The SPL loads the boot partition, 1 KiB header first, to 0x40000000
CONFIG_SYS_TEXT_BASE=0x40000400
CONFIG_SYS_LOAD_ADDR=0x42800000
CONFIG_SYS_BOOTM_LEN=0x4000000
CONFIG_SYS_MALLOC_LEN=0x800000
CONFIG_SYS_MALLOC_F_LEN=0x2000
CONFIG_NR_DRAM_BANKS=1
CONFIG_COUNTER_FREQUENCY=24000000
CONFIG_SKIP_LOWLEVEL_INIT=y
CONFIG_DEFAULT_DEVICE_TREE="ax620u-nand"
CONFIG_OF_CONTROL=y
CONFIG_OF_EMBED=y
CONFIG_OF_LIBFDT=y
CONFIG_DM=y
CONFIG_DISPLAY_CPUINFO=y
CONFIG_MISC_INIT_R=y
CONFIG_FIT=y
CONFIG_LEGACY_IMAGE_FORMAT=y
# CONFIG_EFI_LOADER is not set
# CONFIG_SYSRESET is not set
# CONFIG_ENV_IS_NOWHERE is not set
# CONFIG_MMC is not set

# Console: UART0, DesignWare APB UART
CONFIG_DM_SERIAL=y
CONFIG_SYS_NS16550=y
CONFIG_BAUDRATE=115200
CONFIG_SYS_PROMPT="OpenIPC # "
CONFIG_HUSH_PARSER=y
CONFIG_CMDLINE_EDITING=y
CONFIG_AUTO_COMPLETE=y

# Autoboot: Ctrl-C only
CONFIG_BOOTDELAY=1
CONFIG_AUTOBOOT=y
CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_PROMPT="Hit Ctrl-C to stop autoboot: %2d\n"
CONFIG_AUTOBOOT_STOP_STR="\x03"
CONFIG_AUTOBOOT_KEYED_CTRLC=y

# OpenIPC boot layer: firmware scan, recovery, boot-limit failsafe
CONFIG_OPENIPC=y
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_GENERIC=y
CONFIG_SYS_BOOTCOUNT_SINGLEWORD=y
# DRAM + 0x1f20000, as on the HiSilicon and Xiongmai targets
CONFIG_SYS_BOOTCOUNT_ADDR=0x41F20000

# SPI NAND on the SSI (mainline designware_spi, chip select on a GPIO,
# mainline spi-nand), the environment in its env partition
CONFIG_CLK=y
CONFIG_DM_GPIO=y
CONFIG_DWAPB_GPIO=y
CONFIG_SPI=y
CONFIG_DM_SPI=y
CONFIG_SPI_MEM=y
CONFIG_DESIGNWARE_SPI=y
CONFIG_MTD=y
CONFIG_DM_MTD=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_SPI_NAND=y
CONFIG_MTD_PARTITIONS=y
CONFIG_ENV_IS_IN_NAND=y
CONFIG_ENV_OFFSET=0x280000
CONFIG_ENV_SIZE=0x40000
CONFIG_ENV_RANGE=0x80000
CONFIG_MTD_UBI=y
CONFIG_CMD_UBI=y
CONFIG_CMD_UBIFS=y
CONFIG_CMD_NAND=y
CONFIG_CMD_MTD=y
CONFIG_CMD_MTDPARTS=y
CONFIG_MTDIDS_DEFAULT="nand0=spi4.0_nand"
CONFIG_MTDPARTS_DEFAULT="mtdparts=spi4.0_nand:1024k(spl),1536k(boot),512k(env),-(ubi)"

# Commands
CONFIG_CMD_BOOTM=y
CONFIG_CMD_BOOTZ=y
CONFIG_CMD_GO=y
CONFIG_CMD_RUN=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_ITEST=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_EDITENV=y
CONFIG_CMD_SAVEENV=y
CONFIG_CMD_ENV_EXISTS=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_CRC32=y
CONFIG_CMD_SLEEP=y
CONFIG_CMD_FDT=y
CONFIG_CMD_GPIO=y
# CONFIG_CMD_FLASH is not set
# CONFIG_CMD_LOADS is not set

# No Ethernet driver yet (the EQOS at 0x4970000), so no network commands;
# updates go through the SPI NAND from Linux (sysupgrade)
# CONFIG_NET is not set
