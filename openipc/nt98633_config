CONFIG_TARGET_NT98633=y
CONFIG_PRODUCT_SOC="nt98633"
# Where the loader's device tree (/nvt_memory_cfg/uboot) has U-Boot
# unpacked and BL31 starts it: the HEADINFO's CodeEntry says the same
CONFIG_SYS_TEXT_BASE=0x3E000000
# AArch64 runs with the MMU and caches on (arch/arm/mach-novatek/soc.c)
# CONFIG_SYS_DCACHE_OFF is not set
# Past BL31 (0x1F00000, secure) and the loader's areas, as the vendor
CONFIG_SYS_LOAD_ADDR=0x02000000
# DRAM + 0x1e20000: the other families' 0x1f20000 is in BL31 here
CONFIG_SYS_BOOTCOUNT_ADDR=0x01E20000
CONFIG_SYS_MALLOC_LEN=0x1000000
# No SD slot on the NVRs (and no SDIO driver for these dies)
# CONFIG_MMC is not set
# CONFIG_CMD_MMC is not set
# CONFIG_CMD_FAT is not set
# CONFIG_FS_FAT is not set

# SPI NAND, not NOR: the environment in the board's uenv partition, two
# blocks for one bad, and UBI after it (include/configs/novatek.h)
# CONFIG_NVT_SFLASH is not set
# CONFIG_CMD_SF is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
CONFIG_MTD=y
CONFIG_MTD_RAW_NAND=y
CONFIG_NAND_NVT_SPI=y
CONFIG_CMD_NAND=y
CONFIG_CMD_NAND_TRIMFFS=y
CONFIG_ENV_IS_IN_NAND=y
CONFIG_ENV_OFFSET=0x1A0000
CONFIG_ENV_SIZE=0x20000
CONFIG_ENV_RANGE=0x40000
CONFIG_MTD_PARTITIONS=y
CONFIG_CMD_MTDPARTS=y
CONFIG_CMD_UBI=y
CONFIG_CMD_UBIFS=y
CONFIG_MTD_UBI=y
# CONFIG_MTD_UBI_FASTMAP is not set
CONFIG_LZO=y
