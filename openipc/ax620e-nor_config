# Axera AX620E with SPI NOR. build.sh runs olddefconfig on this, so a
# later line overrides an earlier one.
CONFIG_PRODUCT_SOC="ax620e"
CONFIG_ARM=y
CONFIG_ARCH_AXERA=y
CONFIG_AXERA_AX620E=y
# The first stage unpacks the image's payload to 0x5C000400 and starts it
# there in EL1; ax620e-image.py puts a branch there to U-Boot, at the next
# 4 KiB boundary (arm64 relocates by whole pages)
CONFIG_SYS_TEXT_BASE=0x5C001000
CONFIG_COUNTER_FREQUENCY=24000000
CONFIG_DEFAULT_DEVICE_TREE="ax620e-openipc"
CONFIG_SYS_MALLOC_F_LEN=0x2000
CONFIG_SYS_MALLOC_LEN=0x400000
CONFIG_SYS_LOAD_ADDR=0x45000000
CONFIG_NR_DRAM_BANKS=1
CONFIG_DISPLAY_CPUINFO=y
CONFIG_MISC_INIT_R=y

# Console: UART0, a DesignWare 16550 at 208 MHz
CONFIG_SYS_NS16550=y
CONFIG_BAUDRATE=115200
CONFIG_SYS_PROMPT="OpenIPC # "
CONFIG_HUSH_PARSER=y
CONFIG_CMDLINE_EDITING=y
CONFIG_AUTO_COMPLETE=y

# Autoboot: Ctrl-C only
CONFIG_BOOTDELAY=1
CONFIG_AUTOBOOT=y
CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_PROMPT="Hit Ctrl-C to stop autoboot: %2d\n"
CONFIG_AUTOBOOT_STOP_STR="\x03"
CONFIG_AUTOBOOT_KEYED_CTRLC=y

# OpenIPC boot layer: firmware scan, recovery, boot-limit failsafe
CONFIG_OPENIPC=y
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_GENERIC=y
CONFIG_SYS_BOOTCOUNT_SINGLEWORD=y
# DRAM + 0x1f20000, as on the other targets
CONFIG_SYS_BOOTCOUNT_ADDR=0x41F20000
CONFIG_LEGACY_IMAGE_FORMAT=y

# SPI NOR on the boot flash controller, and the environment in it
CONFIG_DM_GPIO=y
CONFIG_AXERA_GPIO=y
CONFIG_SPI=y
CONFIG_DM_SPI=y
CONFIG_AXERA_SPI=y
CONFIG_SPI_FLASH=y
CONFIG_DM_SPI_FLASH=y
CONFIG_SF_DEFAULT_SPEED=50000000
CONFIG_SF_DEFAULT_MODE=0x0
# CONFIG_SPI_FLASH_USE_4K_SECTORS is not set
CONFIG_SPI_FLASH_EON=y
CONFIG_SPI_FLASH_GIGADEVICE=y
CONFIG_SPI_FLASH_ISSI=y
CONFIG_SPI_FLASH_MACRONIX=y
CONFIG_SPI_FLASH_WINBOND=y
CONFIG_SPI_FLASH_XMC=y
CONFIG_SPI_FLASH_XTX=y
CONFIG_CMD_SF=y
CONFIG_ENV_IS_IN_SPI_FLASH=y
CONFIG_ENV_OFFSET=0x40000
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_SECT_SIZE=0x10000
# gd->env_addr points into the image at 0x5C000000 until relocated: past
# the DRAM the memory map covers once the MMU is on
CONFIG_SYS_RELOC_GD_ENV_ADDR=y

# Commands
CONFIG_CMD_BOOTM=y
CONFIG_CMD_GO=y
CONFIG_CMD_RUN=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_ITEST=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_EDITENV=y
CONFIG_CMD_SAVEENV=y
CONFIG_CMD_ENV_EXISTS=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_CRC32=y
CONFIG_CMD_SLEEP=y
CONFIG_CMD_GPIO=y
CONFIG_CMD_LOADB=y
# CONFIG_CMD_LOADS is not set
# CONFIG_CMD_ELF is not set
# CONFIG_CMD_BOOTEFI is not set
# CONFIG_CMD_IMPORTENV is not set
# CONFIG_CMD_EXPORTENV is not set
# CONFIG_CMD_CONSOLE is not set
# CONFIG_CMD_BDI is not set
# CONFIG_CMD_RANDOM is not set
# CONFIG_EFI_LOADER is not set
CONFIG_SYS_BOOTM_LEN=0x4000000
# CONFIG_EFI_PARTITION is not set
# CONFIG_CMD_NFS is not set

# The uImage OpenIPC builds for this SoC is gzip or LZMA; bootm unpacks both
CONFIG_LZMA=y

# Network: the Ethernet MAC, a DWC Ethernet QoS, with its own 10/100 PHY
CONFIG_NET=y
CONFIG_DM_ETH=y
CONFIG_DWC_ETH_QOS=y
CONFIG_DWC_ETH_QOS_AXERA=y
CONFIG_PHYLIB=y
CONFIG_CMD_NET=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_NET_RANDOM_ETHADDR=y
CONFIG_LIB_RAND=y

# SD card: Cadence SD4HC; recovery (common/openipc.c) and srcmmc read FAT
CONFIG_MMC=y
CONFIG_DM_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_CADENCE=y
CONFIG_CMD_MMC=y
CONFIG_CMD_FAT=y
CONFIG_FS_FAT=y
CONFIG_DOS_PARTITION=y
# CONFIG_MMC_HW_PARTITIONING is not set
# Read only, and little else: the boot partition is tight
# CONFIG_MMC_WRITE is not set
# CONFIG_MMC_QUIRKS is not set
# CONFIG_MMC_VERBOSE is not set
# CONFIG_BLOCK_CACHE is not set
# CONFIG_BOOTSTD is not set

# USB host: DWC3 (xHCI), mass storage for srcusb and the recovery
CONFIG_USB=y
CONFIG_DM_USB=y
CONFIG_USB_HOST=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_DWC3=y
CONFIG_USB_STORAGE=y
CONFIG_CMD_USB=y
