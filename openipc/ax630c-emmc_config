# Axera AX630C with eMMC and an SD slot (Sipeed MaixCAM2). build.sh runs
# olddefconfig on this, so a later line overrides an earlier one.
CONFIG_PRODUCT_SOC="ax630c"
CONFIG_ARM=y
CONFIG_ARCH_AXERA=y
CONFIG_AXERA_AX620E=y
CONFIG_AXERA_AX630C_EMMC=y
# Loaded here and started with go by the board's own U-Boot (output/
# u-boot-ax630c.bin on the card). Clear of what that U-Boot occupies
# (0x5C000000 on), its ATF (0x40040000) and OP-TEE (0x44200000, 32 MiB);
# 4 KiB aligned (arm64 relocates by whole pages)
CONFIG_SYS_TEXT_BASE=0x50000000
CONFIG_COUNTER_FREQUENCY=24000000
CONFIG_DEFAULT_DEVICE_TREE="ax630c-openipc"
CONFIG_SYS_MALLOC_F_LEN=0x2000
CONFIG_SYS_MALLOC_LEN=0x800000
CONFIG_SYS_LOAD_ADDR=0x48000000
CONFIG_NR_DRAM_BANKS=1
CONFIG_DISPLAY_CPUINFO=y
CONFIG_MISC_INIT_R=y
# The kernel's device tree: its memory node from the DRAM size, and the
# board's ATF/OP-TEE when U-Boot runs above them (ft_board_setup())
CONFIG_OF_LIBFDT=y
CONFIG_OF_BOARD_SETUP=y

# Console: UART0, a DesignWare 16550 at 208 MHz
CONFIG_SYS_NS16550=y
CONFIG_BAUDRATE=115200
CONFIG_SYS_PROMPT="OpenIPC # "
CONFIG_HUSH_PARSER=y
CONFIG_CMDLINE_EDITING=y
CONFIG_AUTO_COMPLETE=y

# Autoboot: Ctrl-C only
CONFIG_BOOTDELAY=1
CONFIG_AUTOBOOT=y
CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_PROMPT="Hit Ctrl-C to stop autoboot: %2d\n"
CONFIG_AUTOBOOT_STOP_STR="\x03"
CONFIG_AUTOBOOT_KEYED_CTRLC=y

# OpenIPC boot layer: firmware scan (card, then eMMC), boot-limit failsafe
CONFIG_OPENIPC=y
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_GENERIC=y
CONFIG_SYS_BOOTCOUNT_SINGLEWORD=y
# DRAM + 0x1f20000, as on the other targets
CONFIG_SYS_BOOTCOUNT_ADDR=0x41F20000
CONFIG_LEGACY_IMAGE_FORMAT=y
CONFIG_FIT=y

# MMC: the eMMC (mmc 0) and the TF slot (mmc 1), Cadence SD4HC
CONFIG_MMC=y
CONFIG_DM_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_CADENCE=y
CONFIG_MMC_WRITE=y
CONFIG_CMD_MMC=y
CONFIG_DOS_PARTITION=y
CONFIG_EFI_PARTITION=y
# CONFIG_MMC_HW_PARTITIONING is not set
# CONFIG_MMC_VERBOSE is not set
# CONFIG_BOOTSTD is not set

# The environment on the eMMC (user area), in OpenIPC's layout:
# 768k(boot),256k(env),... It fills its partition. An area that is neither
# blank nor an environment (the board's own firmware) is left alone
# (common/openipc.c mmc_get_env_addr()) and the defaults are used.
CONFIG_ENV_IS_IN_MMC=y
CONFIG_SYS_MMC_ENV_DEV=0
CONFIG_SYS_MMC_ENV_PART=0
CONFIG_ENV_OFFSET=0xC0000
CONFIG_ENV_SIZE=0x40000
# gd->env_addr points into the image until relocated
CONFIG_SYS_RELOC_GD_ENV_ADDR=y

# File systems: FAT (the card's first partition), ext4 (the roots)
CONFIG_CMD_FAT=y
CONFIG_FS_FAT=y
CONFIG_CMD_EXT4=y
CONFIG_FS_EXT4=y
CONFIG_CMD_FS_GENERIC=y

# Commands
CONFIG_CMD_BOOTM=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_GO=y
CONFIG_CMD_RUN=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_ITEST=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_EDITENV=y
CONFIG_CMD_SAVEENV=y
CONFIG_CMD_ERASEENV=y
CONFIG_CMD_ENV_EXISTS=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_CRC32=y
CONFIG_CMD_SLEEP=y
CONFIG_CMD_FDT=y
CONFIG_CMD_LOADB=y
# CONFIG_CMD_LOADS is not set
# CONFIG_CMD_ELF is not set
# CONFIG_CMD_BOOTEFI is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_CMD_NFS is not set
CONFIG_SYS_BOOTM_LEN=0x4000000

# The uImage or FIT on the eMMC may be gzip or LZMA; bootm unpacks both
CONFIG_LZMA=y

# Network: the Ethernet MAC, a DWC Ethernet QoS, with its own 10/100 PHY
# (its glue takes an optional PHY reset GPIO)
CONFIG_DM_GPIO=y
CONFIG_NET=y
CONFIG_DM_ETH=y
CONFIG_DWC_ETH_QOS=y
CONFIG_DWC_ETH_QOS_AXERA=y
CONFIG_PHYLIB=y
CONFIG_CMD_NET=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_NET_RANDOM_ETHADDR=y
CONFIG_LIB_RAND=y
