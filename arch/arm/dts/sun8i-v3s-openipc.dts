/*
 * A V3s IP camera: console on UART0 (PB8/PB9), SPI NOR on SPI0 (PC0-PC3),
 * the SD card on MMC0 (PF0-PF5), the EMAC on the SoC's own PHY.
 */

/dts-v1/;

#include "sun8i-v3s.dtsi"

/ {
	model = "OpenIPC V3s";
	compatible = "openipc,v3s", "allwinner,sun8i-v3s";

	aliases {
		ethernet0 = &emac;
		serial0 = &uart0;
		spi0 = &spi0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&emac {
	allwinner,leds-active-low;
	status = "okay";
};

&mmc0 {
	broken-cd;
	bus-width = <4>;
	status = "okay";
};

&spi0 {
	status = "okay";

	flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
	};
};

&uart0 {
	pinctrl-0 = <&uart0_pb_pins>;
	pinctrl-names = "default";
	status = "okay";
};
