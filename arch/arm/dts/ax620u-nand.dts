// SPDX-License-Identifier: GPL-2.0+
/*
 * Axera AX620U camera with SPI NAND: what U-Boot drives. Addresses from
 * the stock AX620U U-Boot's and kernel's devicetrees; the DDR size is
 * the one the stock U-Boot reports.
 */
/dts-v1/;

#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Axera AX620U (OpenIPC)";
	compatible = "axera,ax620x";
	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
		serial0 = &uart0;
		spi4 = &spi4;
		ethernet0 = &eth0;
		mmc0 = &sd;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x10000000>;
	};

	timer {
		compatible = "arm,armv7-timer";
		clock-frequency = <24000000>;
	};

	/*
	 * The stock U-Boot's ap_clk. The first stage has set the UART and SSI
	 * clocks; U-Boot only divides them.
	 */
	ap_clk: ap-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000000>;
		u-boot,dm-pre-reloc;
	};

	uart0: serial@4990000 {
		compatible = "snps,dw-apb-uart";
		reg = <0x4990000 0x100>;
		reg-shift = <2>;
		reg-io-width = <4>;
		clocks = <&ap_clk>;
		u-boot,dm-pre-reloc;
	};

	gpio@10010000 {
		compatible = "snps,dw-apb-gpio";
		reg = <0x10010000 0x400>;
		#address-cells = <1>;
		#size-cells = <0>;

		gpio2: gpio-controller@0 {
			compatible = "snps,dw-apb-gpio-port";
			gpio-controller;
			#gpio-cells = <2>;
			snps,nr-gpios = <32>;
			reg = <0>;
		};
	};

	gpio@4960000 {
		compatible = "snps,dw-apb-gpio";
		reg = <0x4960000 0x400>;
		#address-cells = <1>;
		#size-cells = <0>;

		gpio1: gpio-controller@0 {
			compatible = "snps,dw-apb-gpio-port";
			gpio-controller;
			#gpio-cells = <2>;
			snps,nr-gpios = <32>;
			reg = <0>;
		};
	};

	/*
	 * The SPI NAND's DesignWare SSI ("snps,dw-ssi" in the stock trees),
	 * with the DWC_ssi register layout, and its chip select on GPIO2 5.
	 * Mainline's driver moves one data line, so the NAND is driven at
	 * single width; spi-max-frequency keeps the divider at 8 or more.
	 */
	spi4: spi@8000000 {
		compatible = "snps,dwc-ssi-1.01a";
		reg = <0x8000000 0x1000>;
		#address-cells = <1>;
		#size-cells = <0>;
		clocks = <&ap_clk>;
		cs-gpios = <&gpio2 5 0>;
		spi-max-frequency = <25000000>;

		spi-nand@0 {
			compatible = "spi-nand";
			reg = <0>;
			spi-max-frequency = <25000000>;
			spi-tx-bus-width = <1>;
			spi-rx-bus-width = <1>;
		};
	};

	/*
	 * The DWC Ethernet QoS, RMII to an external PHY (an RTL8201F at
	 * MDIO address 1 in the stock kernel's tree) whose TXC drives the
	 * 50 MHz reference clock ("rmii-phy-dir" "output", the stock glue's
	 * "RMII PHY TXC output mode"); the PHY's reset is GPIO1 28, low in
	 * reset. "emac-bus-clock" is the CSR clock.
	 */
	eth0: ethernet@4970000 {
		compatible = "axera,ax620-eqos";
		reg = <0x4970000 0x10000>;
		emac-bus-clock = <312000000>;
		phy-mode = "rmii";
		rmii-phy-dir = "output";
		phy-reset-gpios = <&gpio1 28 GPIO_ACTIVE_LOW>;
	};

	/*
	 * The SD card slot: Cadence SD4HC, 4 bits, 3.3 V only, card detect
	 * on GPIO1 2 (low with a card in). The PHY delays are the stock
	 * U-Boot's; the base clock comes from the capabilities register.
	 */
	sd: mmc@4950000 {
		compatible = "socionext,uniphier-sd4hc", "cdns,sd4hc";
		reg = <0x4950000 0x10000>;
		bus-width = <4>;
		sdhci-caps-mask = <0x7 0x200000>;
		cap-sd-highspeed;
		no-1-8-v;
		no-sdio;
		no-mmc;
		disable-wp;
		cd-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
		cd-inverted;
		cdns,phy-input-delay-sd-highspeed = <0x2>;
		cdns,phy-input-delay-legacy = <0x4>;
		cdns,phy-input-delay-sd-uhs-sdr12 = <0x1>;
		cdns,phy-input-delay-sd-uhs-sdr25 = <0x2>;
		cdns,phy-input-delay-sd-uhs-sdr50 = <0x1>;
		cdns,phy-input-delay-sd-uhs-ddr50 = <0x2>;
		cdns,phy-input-delay-mmc-highspeed = <0x2>;
		cdns,phy-input-delay-mmc-ddr = <0x2>;
		cdns,phy-dll-delay-sdclk = <0x0>;
		cdns,phy-dll-delay-sdclk-hsmmc = <0x17>;
	};
};
