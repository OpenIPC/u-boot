if ARCH_ANYKA

choice
	prompt "Anyka SoC"
	default TARGET_AK3918EV300

config TARGET_AK3918EV200
	bool "AK3918EV200"
	select AK39_EV200
	help
	  Cloud39E: 64 MiB of DDR2 in the package, boot header AKSH_240.

config TARGET_AK3916EV300
	bool "AK3916EV300"
	select AK39_EV300
	help
	  AnyCloud39EV300, 64 MiB. The AK3916EV301 runs the same image.

config TARGET_AK3918EV300
	bool "AK3918EV300"
	select AK39_EV300
	help
	  AnyCloud39EV300, 64 MiB.

config TARGET_AK3919EV300
	bool "AK3919EV300"
	select AK39_EV300
	help
	  AnyCloud39EV300, 128 MiB.

config TARGET_AK3918EV330
	bool "AK3918EV330"
	select AK39_EV330
	help
	  AnyCloud V500, 64 MiB. The mask ROM loads a first stage into L2
	  memory, which loads U-Boot.

config TARGET_AK3919EV330
	bool "AK3919EV330"
	select AK39_EV330
	help
	  AnyCloud V500, 128 MiB.

config TARGET_AK3918EV300L
	bool "AK3918EV300L"
	select AK39_AV100
	help
	  AnyCloud39EV300L, 64 MiB, boot header AK_H322L. Not an EV300: a
	  24 MHz crystal, a new PLL layout, the SPI controllers at
	  0x21100000, shared pins from 0x178, SD on MCI1. The AK3918EV300W
	  is the same chip.

config TARGET_AK3918AV100
	bool "AK3918AV100"
	select AK39_AV100
	help
	  AnyCloud39AV100: AK3918AV100N, AK3918AV100P and KM01N, 64 MiB,
	  boot header ANYKA322. The EV300L's register map; U-Boot starts at
	  flash offset 0x600, past a secure-boot area the mask ROM copies
	  with it from 0x200 (load address 0x80DFFC00).

config TARGET_AK3918AV100X
	bool "AK3918AV100X"
	select AK39_AV100
	help
	  AnyCloud39AV100: AK3918AV100X, AK3918AV100XP and KM01D, 128 MiB.

endchoice

config AK39_EV200
	bool

config AK39_EV300
	bool

config AK39_EV330
	bool

config AK39_AV100
	bool
	help
	  The AK3918AV100 family (AnyCloud39AV100 and AnyCloud39EV300L): a
	  24 MHz crystal, PLL2 for the peripherals, SPI0 at 0x21100000,
	  shared pins in 3-bit fields from 0x178, SD on MCI1.

config SYS_SOC
	default "anyka"

config SYS_VENDOR
	default "anyka"

config SYS_BOARD
	default "ak39"

config SYS_CONFIG_NAME
	default "anyka"

endif
