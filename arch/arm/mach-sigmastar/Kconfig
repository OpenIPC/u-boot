config SS_INFINITY3
	bool

config SS_INFINITY2M
	bool

config SS_INFINITY6
	bool

config SS_INFINITY6B0
	bool

config SS_INFINITY6E
	bool

config SS_INFINITY6C
	bool

config SS_IFORD
	bool

config SS_IFADO
	bool

config SS_IFLIEGEN
	bool

# Iford and Ifliegen: the FSP at 0x100D, BDMA from MIU by channel 1, no MIU
# write pipe to flush
config SS_IFORD_FAMILY
	def_bool SS_IFORD || SS_IFLIEGEN

# What infinity6c, Iford and Ifliegen share: the boot flash's chip select in
# software, the Ethernet PHY at bank 0x1518 (and, but on Ifliegen, the DDR
# size in bank 0x1659)
config SS_I6C_FAMILY
	def_bool SS_INFINITY6C || SS_IFORD || SS_IFLIEGEN

# The FSP-QSPI whose chip select the boot flash's driver holds in software
config SS_FSP_SW_CS
	def_bool SS_I6C_FAMILY || SS_IFADO

# The dies booted with OpenIPC's LX_MEM/mma_heap arguments, whose values
# depend on the DDR size
config SS_MMA_BOOTARGS
	def_bool SS_INFINITY2M || SS_INFINITY6 || SS_INFINITY6B0 || SS_INFINITY6E || SS_I6C_FAMILY || SS_IFADO

config SYS_SOC
	default "sigmastar"

config SYS_VENDOR
	default "sigmastar"

config SYS_BOARD
	default "ipc"

config SYS_CONFIG_NAME
	default "sigmastar"

