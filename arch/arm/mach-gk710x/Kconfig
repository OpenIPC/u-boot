	bool "GK7102"
	help
	  GK7102: the GK7101 die with 64 MiB of DDR2 in the package.

endchoice

config SYS_SOC
	default "gk710x"

config SYS_VENDOR
	default "goke"

config SYS_BOARD
	default "gk710x"

config SYS_CONFIG_NAME
	default "gk710x"

endif
