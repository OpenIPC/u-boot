if ROCKCHIP_RV1106

config TARGET_OPENIPC_RV1106
	bool "OpenIPC RV1106 / RV1103 camera"
	default y
	help
	  An RV1106 or RV1103 camera booting OpenIPC firmware from SPI NOR
	  or SPI NAND.

config SYS_BOARD
	default "rv11xx"

config SYS_VENDOR
	default "rockchip"

config SYS_SOC
	default "rockchip"

config SYS_CONFIG_NAME
	default "rv1106"

config SYS_MALLOC_F_LEN
	default 0x2000

config ROCKCHIP_BOOT_MODE_REG
	default 0xff020200

# SPL: at DRAM 0, where the mask ROM puts it; its BSS and stack below the
# DDR blob's ATAGs at 0x1fe000, U-Boot above them at 0x200000
config SPL_MAX_SIZE
	default 0x28000

config SPL_BSS_START_ADDR
	default 0x180000

config SPL_BSS_MAX_SIZE
	default 0x20000

config SPL_STACK
	default 0x1f0000

endif
