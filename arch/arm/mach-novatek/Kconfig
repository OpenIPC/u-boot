if ARCH_NOVATEK

choice
	prompt "Novatek SoC"
	default TARGET_NT98562

config TARGET_NT98560
	bool "NT98560"
	select NVT_NA51089
	help
	  NA51089 with external DDR3, 512 MiB on the SDK's board.

config TARGET_NT98561
	bool "NT98561"
	select NVT_NA51089
	help
	  NA51089 with 64 MiB of DDR2 in the package, as the NT98562.

config TARGET_NT98562
	bool "NT98562"
	select NVT_NA51089
	help
	  NA51089 with 64 MiB of DDR2 in the package.

config TARGET_NT98566
	bool "NT98566"
	select NVT_NA51089
	help
	  NA51089 with 128 MiB of DDR3 in the package.

config TARGET_NT98520
	bool "NT98520"
	select NVT_NA51055
	help
	  NA51055 (two Cortex-A9s) with external DDR3, one die, 512 MiB
	  as the loader is built.

config TARGET_NT98522
	bool "NT98522"
	select NVT_NA51055
	help
	  NA51055 with 64 MiB of DDR in the package.

config TARGET_NT98523
	bool "NT98523"
	select NVT_NA51055
	help
	  NA51055 with 128 MiB of DDR in the package.

config TARGET_NT98525
	bool "NT98525"
	select NVT_NA51055
	help
	  NA51055 with two external DDR3 dies, 512 MiB each on the SDK's
	  board; U-Boot uses the first.

config TARGET_NT98528
	bool "NT98528"
	select NVT_NA51055
	help
	  NA51084 (two Cortex-A9s, the NT9852x SDK's other die) with two
	  external DDR3 dies, 512 MiB each on the SDK's board.

config TARGET_NT98529
	bool "NT98529"
	select NVT_NA51055
	help
	  NA51084 as the NT98528, its CPU cleared for 1.2 GHz.

config TARGET_NT98332
	bool "NT98332 (NA51103)"
	select NVT_NA51103
	help
	  NA51103, the NVR die with two Cortex-A53s, 1 GiB of DDR on the
	  boards. U-Boot runs in AArch64 at EL2, started by the board's
	  BL31.

config TARGET_NT98633
	bool "NT98633 (NA51090)"
	select NVT_NA51090
	help
	  NA51090, the NVR die with four Cortex-A53s, 2 GiB of DDR on the
	  boards. U-Boot runs in AArch64 at EL2, started by the board's
	  BL31.

config TARGET_NT98321
	bool "NT98321"
	select NVT_NA51068
	help
	  NA51068 (DVR/NVR, two Cortex-A9s) with external DDR3, 512 MiB on
	  the SDK's board, booting from SPI NOR.

config TARGET_NT98323
	bool "NT98323"
	select NVT_NA51068
	help
	  NA51068 (DVR/NVR, two Cortex-A9s) with external DDR4, 512 MiB on
	  the SDK's NOR board.

endchoice

config NVT_NA51089
	bool

config NVT_NA51055
	bool
	help
	  The NT9852x SDK's dies, NA51055 and NA51084: NA51089's blocks at
	  NA51089's addresses, two Cortex-A9s, their own loader
	  (board/novatek/na51055/loader). The chip ID tells them apart.

# The NVR dies: the board's loader warm-resets the A53s into AArch64 and
# its BL31 (TF-A v2.2) enters U-Boot at EL2 with a fixed SPSR (0x3C9), so
# U-Boot is an AArch64 one.
config NVT_NA511XX
	bool
	select ARM64

config NVT_NA51103
	bool
	select NVT_NA511XX

config NVT_NA51090
	bool
	select NVT_NA511XX

config NVT_NA51068
	bool

config NVT_DDR_SIZE
	hex
	default 0x80000000 if TARGET_NT98633
	default 0x40000000 if TARGET_NT98332
	default 0x20000000 if TARGET_NT98560 || NVT_NA51068
	default 0x08000000 if TARGET_NT98566
	default 0x20000000 if TARGET_NT98520 || TARGET_NT98525
	default 0x20000000 if TARGET_NT98528 || TARGET_NT98529
	default 0x08000000 if TARGET_NT98523
	default 0x04000000
	help
	  The DDR at 0: the package's, or the board's for a part with
	  external DDR, as its loader is built. A second DDR die (at
	  0x40000000 on NA51055 / NA51084) is the media pool's alone. On NA51068
	  the loader's device tree (/nvt_memory_cfg/dram) says it; this is
	  the fallback.

config NVT_OSMEM
	string
	default "0x57600000" if NVT_NA51090
	default "0x15e00000" if NVT_NA51103
	default "160M" if TARGET_NT98321
	default "192M" if TARGET_NT98323
	default "256M" if NVT_DDR_SIZE >= 0x20000000
	default "64M" if TARGET_NT98523
	default "32M"
	help
	  What Linux gets of the DDR by default (osmem, mem=); the vendor
	  media modules get the rest. 32M is what OpenIPC's install guide
	  sets on the NT98562/566's vendor U-Boot; larger parts give Linux
	  what their SDK board does (the NT98523's tree keeps its CMA at
	  48 MiB), the NVRs what their firmware sets (Xiongmai's NT98332
	  NVR 0x15e00000, the NT98633 NVR's tree 0x57600000).

config SYS_SOC
	default "novatek"

config SYS_VENDOR
	default "novatek"

config SYS_BOARD
	default "na511xx" if NVT_NA511XX
	default "na51068" if NVT_NA51068
	default "na51089"

config SYS_CONFIG_NAME
	default "novatek"

endif
